PROJECT_NAME=clawd-bot-backend-dev
IMAGE_REF=<dockerhub-user>/clawbot-backend:dev
CONTAINER_NAME=clawbot-backend-dev

HOST_PORT=8600
CONTAINER_PORT=5000
RESTART_POLICY=unless-stopped

HOST_RUNTIME_DIR=/home/qkit/data/clawd-bot-backend-dev/runtime

# Image used when this backend creates OpenClaw instance containers.
# Push/pull this image separately, or pre-load it on the server.
OPENCLAW_IMAGE=<dockerhub-user>/clawd-bot-openclaw:dev

# Backend runs inside Docker, while OpenClaw instances publish their gateway on the host.
# host.docker.internal is mapped to the Linux Docker host by docker-compose.yml.
OPENCLAW_GATEWAY_HOST=host.docker.internal

# Optional: server-deploy.sh will docker login when both are present.
# DOCKERHUB_USERNAME=<dockerhub-user>
# DOCKERHUB_TOKEN=<dockerhub-access-token>

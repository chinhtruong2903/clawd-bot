NODE_ENV=production

# CORS origins for your frontend panel.
PANEL_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Default token used for imported/local instance metadata if needed.
# New instances can still use their own token from the Instances tab.
OPENCLAW_GATEWAY_TOKEN=change-me-dev-token

TZ=Asia/Saigon
ROOT_PASSWORD=change-me-root-password
